# Copia a stack.env (no commitear) o pega estas variables en Portainer → Stack → Environment variables.

# Build del frontend: URL que el navegador usará para llamar al servicio de correo (HTTPS recomendado en prod).
# Ejemplo mismo servidor: http://TU_IP:4001 o https://api.tudominio.com
VITE_MAIL_SERVICE_URL=http://localhost:4001

# Build: licencia Syncfusion (sin espacios; no subir a git).
# VITE_SYNCFUSION_LICENSE=

# Puertos publicados en el host (opcional)
WEB_PORT=80
MAIL_PUBLISH_PORT=4001

# CORS: mismos orígenes que visitan la landing, separados por coma (sin espacios o con trim).
MAIL_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
